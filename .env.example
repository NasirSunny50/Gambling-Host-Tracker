# Local dev uses SQLite. For production swap to Postgres, no code change needed:
#   DATABASE_URL=postgresql+psycopg://ght:password@localhost:5432/ght
DATABASE_URL=sqlite:///./data/ght.db

# Where raw HTML / JSON / screenshot evidence blobs are written
EVIDENCE_DIR=./data/evidence

# Collection behaviour
REQUEST_TIMEOUT=30
MAX_RETRIES=3
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36

# Alerts (all optional, all free channels)
# Teams: Workflows (Power Automate) -> "Post to a channel when a webhook request is received"
TEAMS_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Sign-in credentials, one pair per site, named after the site's slug. With these set a
# run tries to sign in by itself and only opens a window if the site answers with a
# CAPTCHA or 2FA — which 1xBet usually does, so expect to finish that one by hand.
# Leave them empty to sign in entirely through the window, as before.
#
# This file is gitignored. Never put these in sources/*.yaml — those live in git.
GHT_LOGIN_1XBET_BD_USERNAME=
GHT_LOGIN_1XBET_BD_PASSWORD=

# Melbet Bangladesh. Same engine as 1xBet, so expect the same CAPTCHA on sign-in: these
# save the typing, not the challenge.
GHT_LOGIN_MELBET_BD_USERNAME=
GHT_LOGIN_MELBET_BD_PASSWORD=

# Optional: force a specific Chromium build for collection and the sign-in window.
# A Playwright channel name (msedge, chrome) or a full path to any Chromium browser.
# Leave empty to auto-detect whatever is installed.
GHT_BROWSER_PATH=
